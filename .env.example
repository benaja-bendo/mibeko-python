# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# MinerU
# Backend d'extraction : "cloud" (SaaS, défaut) ou "local" (serveur auto-hébergé).
# Pour le dev 100% local, voir mineru-local/ :
#   MINERU_BACKEND=local
#   MINERU_API_URL=http://localhost:8000   (PAS de /api/v4 en local)
MINERU_BACKEND=cloud
MINERU_API_URL="https://mineru.net/api/v4"
MINERU_API_KEY=
MINERU_TIMEOUT=30
MINERU_LANG=fr

# Mistral (extraction de métadonnées LLM)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TIMEOUT_SECONDS=60
# Délai minimal entre deux appels à l'API Mistral, en secondes (clé limitée
# en débit). Backoff exponentiel 5/10/20/40 s sur 429/5xx, géré par le service.
MISTRAL_MIN_INTERVAL_SECONDS=1.5

# Minio
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Uploads
# Taille maximale acceptée pour un fichier uploadé (PDF/MD/JSON), en Mo.
# Au-delà, la lecture s'arrête net et l'API répond 413.
MAX_UPLOAD_MB=100

# Qualité OCR (garde-fou de publication, NON bloquant)
# Score de LISIBILITÉ estimé à l'ingestion (0..1, 1 = propre) à partir de signaux
# réels : caractères illisibles U+FFFD, artefacts OCR connus, fragmentation des
# mots, caractères de contrôle. Sous ce seuil, un flag de curation 'warning' est
# émis (l'éditeur voit l'avertissement mais garde « Publier quand même »). Ce
# n'est PAS une mesure de justesse juridique. Défaut 0.60.
OCR_QUALITY_WARN_THRESHOLD=0.60

# Exposition du service (brique interne)
# Environnement : "production" (défaut) verrouille docs + console.
APP_ENV=production
# Version affichée sur la page de statut et dans /api/v1/health.
SERVICE_VERSION=1.0.0
# Documentation OpenAPI (Swagger/ReDoc). false en production (défaut),
# true en local. Décrit des écritures internes : à ne pas exposer au public.
EXPOSE_API_DOCS=false
# Console d'ingestion HTMX héritée sur /console. false partout (défaut) :
# le vrai outil d'ingestion vit dans le front éditeur (app.mibeko.fr).
INGESTION_CONSOLE_ENABLED=false

# Diagnostic de la PRODUCTION en lecture seule (tunnel SSH)
# Profil lu UNIQUEMENT par src/db/prod_readonly.py et la commande
# « python main.py prod-preflight ». Ni l'API ni le pipeline ne le lisent : les
# écritures du service continuent d'utiliser les variables DB_* ci-dessus.
#
# Prérequis côté serveur : rôle Postgres dédié en lecture seule (GRANT SELECT +
# default_transaction_read_only = on) et service account MinIO en policy readonly
# — jamais les clés root. Cf. docs/infra/acces-prod-diagnostic.md
#
# Ouvrir le tunnel avant usage :
#   ssh -N -L 5434:127.0.0.1:5432 -L 9100:127.0.0.1:9000 ubuntu@<IP_VPS>
#
# Les ports 5434 et 9100 diffèrent volontairement de ceux du développement
# (5433 et 9000) : le module refuse de démarrer si la cible « prod » désigne la
# même base que le dev, car rien d'autre dans le code ne pourrait le détecter.
PROD_RO_DB_HOST=127.0.0.1
PROD_RO_DB_PORT=5434
PROD_RO_DB_DATABASE=
PROD_RO_DB_USERNAME=
PROD_RO_DB_PASSWORD=

PROD_RO_MINIO_ENDPOINT=127.0.0.1:9100
PROD_RO_MINIO_ACCESS_KEY=
PROD_RO_MINIO_SECRET_KEY=
PROD_RO_MINIO_BUCKET=mibeko-documents
PROD_RO_MINIO_SECURE=false

# ATTENTION — aucune variable d'ÉCRITURE en production ne doit être stockée dans
# un fichier, ici comme ailleurs. Une écriture en prod passe par une autorisation
# humaine explicite, opération par opération, et par un canal rejouable
# (commande artisan ou script), jamais par du SQL ad hoc.
