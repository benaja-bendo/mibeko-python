# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# MinerU
# Backend d'extraction : "cloud" (SaaS, défaut) ou "local" (serveur auto-hébergé).
# Pour le dev 100% local, voir ../minerU-docker :
#   MINERU_BACKEND=local
#   MINERU_API_URL=http://localhost:8000   (PAS de /api/v4 en local)
MINERU_BACKEND=cloud
MINERU_API_URL="https://mineru.net/api/v4"
MINERU_API_KEY=
MINERU_TIMEOUT=30
# Langue OCR du backend local (textes juridiques congolais = français).
MINERU_LANG=fr

# Minio
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
