# Copier en .env et ajuster si besoin :  cp .env.example .env

# Port exposé sur l'hôte pour l'API MinerU.
MINERU_PORT=8004

# Source de téléchargement des modèles au 1er lancement :
#   huggingface  → standard, global (défaut)
#   modelscope   → souvent plus rapide hors Chine aussi, sans jeton
# Si les téléchargements huggingface sont lents/bloqués, basculer sur modelscope.
MINERU_MODEL_SOURCE=huggingface
